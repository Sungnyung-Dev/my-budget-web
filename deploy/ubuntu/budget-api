server {
    # 미등록 Host가 이 API 가상 호스트를 통해 접근하지 못하게 합니다.
    listen 443 ssl;
    server_name budget-api.ecoma.kro.kr;
    if ($host != budget-api.ecoma.kro.kr) { return 444; }
    ssl_certificate /etc/letsencrypt/live/budget-api.ecoma.kro.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/budget-api.ecoma.kro.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    include /etc/nginx/snippets/my-budget-auth.conf;
    add_header Cache-Control "no-store, no-cache, must-revalidate, private" always;
    location / {
        include /etc/nginx/snippets/my-budget-proxy.conf;
    }
}
server {
    listen 80;
    server_name budget-api.ecoma.kro.kr;
    return 301 https://budget-api.ecoma.kro.kr$request_uri;
}
